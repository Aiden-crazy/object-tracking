/* app.wxss —— 全局样式 */
page {
  background: #f0f2f5;
  font-size: 28rpx;
  color: #333;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.btn-primary {
  background: #2a5298;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}
.btn-primary::after { border: none; }
.btn-primary[disabled] { background: #9db3d8; color: #fff; }
.input-item { margin-bottom: 20rpx; }
.input-item .label { font-size: 26rpx; color: #666; margin-bottom: 8rpx; }
.input-item input {
  background: #f7f8fc;
  border: 1rpx solid #e3e6ee;
  border-radius: 10rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
}
.badge {
  display: inline-block;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 22rpx;
}
.badge.PENDING { background: #95a5a6; }
.badge.PROCESSING { background: #f39c12; }
.badge.SUCCESS { background: #27ae60; }
.badge.FAILED { background: #e74c3c; }
