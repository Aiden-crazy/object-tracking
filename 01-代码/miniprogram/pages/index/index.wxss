/* pages/index/index.wxss —— 上传页样式 */
.page { padding-bottom: 60rpx; }
.step-title { font-weight: bold; margin-bottom: 18rpx; font-size: 30rpx; }
.pick-area {
  border: 2rpx dashed #b6c3e0; border-radius: 14rpx; padding: 40rpx 20rpx;
  display: flex; flex-direction: column; align-items: center; color: #6a7ba5;
}
.pick-icon { font-size: 64rpx; color: #2a5298; line-height: 1; }
.pick-text { margin-top: 12rpx; font-size: 26rpx; }
.preview { width: 100%; height: 340rpx; border-radius: 10rpx; }
.file-name { margin-top: 14rpx; font-size: 24rpx; color: #555; }
.change-link { margin-top: 8rpx; color: #2a5298; font-size: 24rpx; }
.radio-row {
  display: flex; align-items: center; margin-bottom: 16rpx; font-size: 27rpx;
}
.bbox-row { display: flex; gap: 12rpx; margin-top: 8rpx; }
.bbox-input {
  flex: 1; background: #f7f8fc; border: 1rpx solid #e3e6ee;
  border-radius: 10rpx; padding: 12rpx; text-align: center;
}
.tip { margin-top: 16rpx; color: #999; font-size: 24rpx; }
.submit-btn { margin: 30rpx 20rpx 0; }
