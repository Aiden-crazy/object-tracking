# ============================================================
# .gitignore —— 综合实践III《单目标跟踪系统》
# 说明：保留可执行 jar（跨电脑双击即用），忽略构建中间产物与运行数据。
# ============================================================

# --- Java / Maven 构建中间产物（保留 target/*.jar）---
01-代码/server/target/
!01-代码/server/target/
01-代码/server/target/**
!01-代码/server/target/*.jar

# --- 运行时数据（上传文件、H2 数据库、视觉输出，均可自动重建）---
01-代码/server/uploads/
01-代码/server/trackdb.mv.db
01-代码/server/trackdb.trace.db
demo/vision_out/
demo/.edge*/
demo/*_first.jpg

# --- Python ---
__pycache__/
*.pyc

# --- 构建工具缓存 ---
# build_jar_nomaven.ps1 在无 Maven 环境重打包 jar 时会用到的较新 Lombok，
# 缺失时脚本会自动下载，不必入库（工程本身已附带构建好的 jar）。
tools/lombok/

# --- 微信开发者工具 ---
# project.private.config.json 是「每位开发者本地」的私有配置（由开发者工具自动生成，
# 记录本机调试设置等），官方惯例是不入库，避免互相覆盖。
01-代码/miniprogram/project.private.config.json

# --- IDE / OS ---
.idea/
.vscode/
*.iml
Thumbs.db
desktop.ini
